# Copy this file to .env, then add provider endpoints and credentials.
# Do not commit .env — it is already ignored by Git.

# Poll interval used by the server. The dashboard itself refreshes every 5 seconds.
LIVE_REFRESH_MINUTES=5

# Each endpoint may return a JSON array, { data: [] }, { results: [] },
# { items: [] }, or a GeoJSON FeatureCollection ({ features: [] }).
# If an endpoint requires a bearer token, enter it after the matching API key.

LIVE_SETTLEMENTS_URL=
LIVE_SETTLEMENTS_API_KEY=

LIVE_SITES_URL=
LIVE_SITES_API_KEY=

LIVE_HAZARDS_URL=https://eonet.gsfc.nasa.gov/api/v3/events/geojson?status=open&limit=100
LIVE_HAZARDS_API_KEY=

LIVE_EARTHQUAKES_URL=https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&minlatitude=28.7&maxlatitude=31.5&minlongitude=77.5&maxlongitude=81.1&orderby=time&limit=100
LIVE_EARTHQUAKES_API_KEY=

# Optional: this is monitored as a configured source; weather is not used to
# generate risk scores automatically.
LIVE_WEATHER_URL=https://api.open-meteo.com/v1/forecast?latitude=30.3165&longitude=78.0322&hourly=temperature_2m,precipitation,rain
LIVE_WEATHER_API_KEY=

# Optional generative assistant. It is called only from the backend, never the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
